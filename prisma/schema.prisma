// Aureon Growth - Database schema
// To switch to PostgreSQL in production: change provider to "postgresql" and update DATABASE_URL

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// Lead capture - main contact form submissions
model Lead {
  id           String   @id @default(cuid())
  name         String
  email        String
  phone        String
  company      String?
  service      String
  budget       String?
  message      String
  source       String?  // utm_source, referral, etc.
  status       String   @default("new") // new | contacted | qualified | won | lost
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([email])
  @@index([status])
  @@index([createdAt])
}

// Contactos — libreta central del Command Center (migrado de localStorage a DB).
// tags/fields como JSON serializado para portabilidad SQLite ↔ Postgres.
// country/createdBy preparan la estructura multi-país y la auth por persona.
model Contact {
  id         String   @id @default(cuid())
  name       String
  company    String?
  phone      String?
  email      String?
  instagram  String?
  tags       String   @default("[]")   // JSON: string[]
  fields     String   @default("{}")   // JSON: Record<string,string>
  source     String   @default("Manual")
  country    String   @default("CO")   // multi-país (CO, MX, ES, US…)
  createdBy  String?                    // id de usuario (auth futura)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([country])
  @@index([createdAt])
}

// Clientes — cuentas activas/pausadas/potenciales del Command Center.
// services/projects como JSON serializado (mismo criterio que tags/fields).
// projects guarda ids de referencia rápida; la fuente de verdad de la
// relación real vive en Project.clientId.
model Client {
  id              String   @id @default(cuid())
  company         String
  contact         String   @default("")
  email           String?
  phone           String?
  services        String   @default("[]")   // JSON: string[]
  status          String   @default("Potencial")
  startDate       String   @default("")
  monthlyValue    Float    @default(0)
  projects        String   @default("[]")   // JSON: string[] (ids)
  pendingInvoices Int      @default(0)
  notes           String?
  country         String   @default("CO")
  createdBy       String?                    // id de usuario (auth futura)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([status])
  @@index([country])
  @@index([createdAt])
}

// Tareas — trabajo operativo del equipo. tags/subtasks como JSON serializado
// (mismo criterio que tags/fields en Contact). projectId/clientId son
// referencias sueltas (sin relación Prisma) para no forzar el orden de
// creación entre módulos — igual que projects en Client.
model Task {
  id          String   @id @default(cuid())
  title       String
  description String?
  projectId   String?
  clientId    String?
  service     String?
  owner       String   @default("")
  dueDate     String   @default("")
  priority    String   @default("medium")
  status      String   @default("Pendiente")
  tags        String   @default("[]")   // JSON: string[]
  subtasks    String   @default("[]")   // JSON: { title: string; done: boolean }[]
  country     String   @default("CO")
  createdBy   String?                    // id de usuario (auth futura)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([status])
  @@index([priority])
  @@index([clientId])
  @@index([projectId])
  @@index([country])
  @@index([createdAt])
}

// Proyectos — trabajos activos por etapa (kanban/tabla). deliverables como
// JSON serializado (mismo criterio que tags/subtasks). clientId es referencia
// suelta (sin relación Prisma), igual que en Task.
model Project {
  id           String   @id @default(cuid())
  name         String
  clientId     String   @default("")
  service      String   @default("")
  owner        String   @default("")
  startDate    String   @default("")
  dueDate      String   @default("")
  priority     String   @default("medium")
  progress     Int      @default(0)
  status       String   @default("Backlog")
  budget       Float    @default(0)
  deliverables String   @default("[]")   // JSON: { title: string; done: boolean }[]
  country      String   @default("CO")
  createdBy    String?                    // id de usuario (auth futura)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([status])
  @@index([clientId])
  @@index([country])
  @@index([createdAt])
}

// Facturación — control administrativo interno (no es facturación electrónica
// oficial). clientId es referencia suelta, igual que en Task/Project.
model Invoice {
  id            String   @id @default(cuid())
  number        String   @default("")
  clientId      String   @default("")
  concept       String   @default("")
  issueDate     String   @default("")
  dueDate       String   @default("")
  subtotal      Float    @default(0)
  taxes         Float    @default(0)
  total         Float    @default(0)
  status        String   @default("Borrador")
  paymentMethod String?
  receiptRef    String?
  notes         String?
  country       String   @default("CO")
  createdBy     String?                    // id de usuario (auth futura)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([status])
  @@index([clientId])
  @@index([country])
  @@index([createdAt])
}

// Gastos — gastos operativos, proveedores y suscripciones recurrentes.
model Expense {
  id            String   @id @default(cuid())
  date          String   @default("")
  vendor        String   @default("")
  category      String   @default("")
  concept       String   @default("")
  value         Float    @default(0)
  paymentMethod String   @default("")
  status        String   @default("Pendiente")
  receiptRef    String?
  recurrent     Boolean  @default(false)
  notes         String?
  country       String   @default("CO")
  createdBy     String?                    // id de usuario (auth futura)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([status])
  @@index([category])
  @@index([recurrent])
  @@index([country])
  @@index([createdAt])
}

// Propuestas comerciales por etapa. clientId es referencia suelta.
model Proposal {
  id          String   @id @default(cuid())
  clientId    String   @default("")
  service     String   @default("")
  value       Float    @default(0)
  status      String   @default("Borrador")
  sentDate    String?
  dueDate     String?
  owner       String   @default("")
  probability Int      @default(0)
  notes       String?
  country     String   @default("CO")
  createdBy   String?                    // id de usuario (auth futura)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([status])
  @@index([clientId])
  @@index([country])
  @@index([createdAt])
}

// Contratos — acuerdos comerciales, estados y vencimientos. La firma legal
// real se integra con un proveedor externo (fuera de este modelo).
model Contract {
  id        String   @id @default(cuid())
  clientId  String   @default("")
  type      String   @default("Retainer")
  startDate String   @default("")
  endDate   String?
  value     Float    @default(0)
  status    String   @default("Borrador")
  renewal   String?
  fileRef   String?
  notes     String?
  country   String   @default("CO")
  createdBy String?                    // id de usuario (auth futura)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([clientId])
  @@index([country])
  @@index([createdAt])
}

// Deals — pipeline comercial del Command Center.
// value como Float (portable SQLite<->Postgres, precisión suficiente para
// COP/USD/EUR). El campo currency permite pipelines por país sin mezclar.
model Deal {
  id         String   @id @default(cuid())
  name       String
  contact    String   @default("")
  value      Float    @default(0)
  currency   String   @default("COP")     // COP | USD | EUR | MXN
  stage      String   @default("Nuevo")
  notes      String?
  country    String   @default("CO")
  createdBy  String?                       // id de usuario (auth futura)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([stage])
  @@index([country])
  @@index([createdAt])
}

// Conversaciones del Inbox omnicanal (WhatsApp, IG, FB, Email, Web).
// messages como JSON serializado (Msg[]): mismo criterio que tags/fields
// — portable SQLite<->Postgres, sin migración por cada campo nuevo.
// unread + createdAt indexados para listar rápido "sin responder / recientes".
model Conversation {
  id           String   @id @default(cuid())
  name         String
  channel      String   // whatsapp | instagram | facebook | email | web
  phone        String?
  handle       String?
  messages     String   @default("[]")   // JSON: Msg[]
  unread       Boolean  @default(false)
  country      String   @default("CO")
  createdBy    String?                    // id de usuario (auth futura)
  assignedTo   String?                    // agente asignado (routing multi-país)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([channel])
  @@index([unread])
  @@index([country])
  @@index([updatedAt])
}

// Broadcasts — campañas Meta Ads y difusiones WhatsApp por plantilla.
// sent como JSON (string[] de ids de contacto ya enviados) — mismo criterio
// que tags/fields/messages: portable y sin migración por tracking incremental.
model Broadcast {
  id           String   @id @default(cuid())
  name         String
  kind         String   // "whatsapp" | "meta-ads"
  audienceTag  String   @default("")     // "" = todos
  templateId   String?
  objective    String?
  budget       String?
  status       String   @default("Borrador")  // Borrador | Activo | Cerrado
  sent         String   @default("[]")   // JSON: string[]
  country      String   @default("CO")
  createdBy    String?                    // id de usuario (auth futura)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([kind])
  @@index([status])
  @@index([country])
  @@index([createdAt])
}

// Pool de prospectos capturados desde el mapa (OpenStreetMap/Overpass).
// osmId hace único cada negocio real; contacted + leadId unifican los dos
// flags que hoy viven en localStorage (contactado / convertido a lead).
model PoolItem {
  id             String   @id @default(cuid())
  osmId          String   @unique   // p.ej. "node-123456" — de OSM
  name           String
  category       String              // slug interno (restaurant, cafe, dentist…)
  categoryLabel  String              // etiqueta visible
  color          String   @default("#D6B46A")
  lat            Float
  lon            Float
  phone          String?
  website        String?
  email          String?
  street         String?
  zoneLabel      String              // "Chapinero", "Chicó · Zona Rosa", etc.
  country        String   @default("CO")
  contacted      Boolean  @default(false)
  leadId         String?             // enlace al Lead si ya se convirtió
  createdBy      String?             // id de usuario (auth futura)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([category])
  @@index([contacted])
  @@index([country])
  @@index([createdAt])
}

// Newsletter subscriptions
model Subscriber {
  id          String   @id @default(cuid())
  email       String   @unique
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())

  @@index([email])
}
