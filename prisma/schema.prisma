// Aureon Growth - Database schema
// To switch to PostgreSQL in production: change provider to "postgresql" and update DATABASE_URL

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// Lead capture - main contact form submissions
model Lead {
  id           String   @id @default(cuid())
  name         String
  email        String
  phone        String
  company      String?
  service      String
  budget       String?
  message      String
  source       String?  // utm_source, referral, etc.
  status       String   @default("new") // new | contacted | qualified | won | lost
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([email])
  @@index([status])
  @@index([createdAt])
}

// Contactos — libreta central del Command Center (migrado de localStorage a DB).
// tags/fields como JSON serializado para portabilidad SQLite ↔ Postgres.
// country/createdBy preparan la estructura multi-país y la auth por persona.
model Contact {
  id         String   @id @default(cuid())
  name       String
  company    String?
  phone      String?
  email      String?
  instagram  String?
  tags       String   @default("[]")   // JSON: string[]
  fields     String   @default("{}")   // JSON: Record<string,string>
  source     String   @default("Manual")
  country    String   @default("CO")   // multi-país (CO, MX, ES, US…)
  createdBy  String?                    // id de usuario (auth futura)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([country])
  @@index([createdAt])
}

// Clientes — cuentas activas/pausadas/potenciales del Command Center.
// services/projects como JSON serializado (mismo criterio que tags/fields).
// projects guarda ids de referencia rápida; la fuente de verdad de la
// relación real vive en Project.clientId.
model Client {
  id              String   @id @default(cuid())
  company         String
  contact         String   @default("")
  email           String?
  phone           String?
  services        String   @default("[]")   // JSON: string[]
  status          String   @default("Potencial")
  startDate       String   @default("")
  monthlyValue    Float    @default(0)
  projects        String   @default("[]")   // JSON: string[] (ids)
  pendingInvoices Int      @default(0)
  notes           String?
  country         String   @default("CO")
  createdBy       String?                    // id de usuario (auth futura)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([status])
  @@index([country])
  @@index([createdAt])
}

// Deals — pipeline comercial del Command Center.
// value como Float (portable SQLite<->Postgres, precisión suficiente para
// COP/USD/EUR). El campo currency permite pipelines por país sin mezclar.
model Deal {
  id         String   @id @default(cuid())
  name       String
  contact    String   @default("")
  value      Float    @default(0)
  currency   String   @default("COP")     // COP | USD | EUR | MXN
  stage      String   @default("Nuevo")
  notes      String?
  country    String   @default("CO")
  createdBy  String?                       // id de usuario (auth futura)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([stage])
  @@index([country])
  @@index([createdAt])
}

// Conversaciones del Inbox omnicanal (WhatsApp, IG, FB, Email, Web).
// messages como JSON serializado (Msg[]): mismo criterio que tags/fields
// — portable SQLite<->Postgres, sin migración por cada campo nuevo.
// unread + createdAt indexados para listar rápido "sin responder / recientes".
model Conversation {
  id           String   @id @default(cuid())
  name         String
  channel      String   // whatsapp | instagram | facebook | email | web
  phone        String?
  handle       String?
  messages     String   @default("[]")   // JSON: Msg[]
  unread       Boolean  @default(false)
  country      String   @default("CO")
  createdBy    String?                    // id de usuario (auth futura)
  assignedTo   String?                    // agente asignado (routing multi-país)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([channel])
  @@index([unread])
  @@index([country])
  @@index([updatedAt])
}

// Broadcasts — campañas Meta Ads y difusiones WhatsApp por plantilla.
// sent como JSON (string[] de ids de contacto ya enviados) — mismo criterio
// que tags/fields/messages: portable y sin migración por tracking incremental.
model Broadcast {
  id           String   @id @default(cuid())
  name         String
  kind         String   // "whatsapp" | "meta-ads"
  audienceTag  String   @default("")     // "" = todos
  templateId   String?
  objective    String?
  budget       String?
  status       String   @default("Borrador")  // Borrador | Activo | Cerrado
  sent         String   @default("[]")   // JSON: string[]
  country      String   @default("CO")
  createdBy    String?                    // id de usuario (auth futura)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([kind])
  @@index([status])
  @@index([country])
  @@index([createdAt])
}

// Pool de prospectos capturados desde el mapa (OpenStreetMap/Overpass).
// osmId hace único cada negocio real; contacted + leadId unifican los dos
// flags que hoy viven en localStorage (contactado / convertido a lead).
model PoolItem {
  id             String   @id @default(cuid())
  osmId          String   @unique   // p.ej. "node-123456" — de OSM
  name           String
  category       String              // slug interno (restaurant, cafe, dentist…)
  categoryLabel  String              // etiqueta visible
  color          String   @default("#D6B46A")
  lat            Float
  lon            Float
  phone          String?
  website        String?
  email          String?
  street         String?
  zoneLabel      String              // "Chapinero", "Chicó · Zona Rosa", etc.
  country        String   @default("CO")
  contacted      Boolean  @default(false)
  leadId         String?             // enlace al Lead si ya se convirtió
  createdBy      String?             // id de usuario (auth futura)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([category])
  @@index([contacted])
  @@index([country])
  @@index([createdAt])
}

// Newsletter subscriptions
model Subscriber {
  id          String   @id @default(cuid())
  email       String   @unique
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())

  @@index([email])
}
